# LIFELINE local environment (placeholders only — never commit real values).
# Copy to `.env` and fill in for cloud-sync development. The app works
# fully offline without these; CloudSyncService stays dormant.
# RLS note: the anon key is safe to ship ONLY with Row Level Security
# confining it (see docs/SUPABASE_SCHEMA.sql). Never use a service-role
# key or database password in frontend/mobile code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
