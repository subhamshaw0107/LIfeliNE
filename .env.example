# LIFELINE Environment Variables - PLACEHOLDER FILE
# ===================================================
# Copy to `.env.local` and fill in for local development.
# NEVER commit real secrets to Git.
# All vars prefixed with VITE_ are exposed to frontend bundle.
# Vars WITHOUT VITE_ prefix must only be set in Vercel server-side env vars.

# ── SUPABASE (Optional - app works fully offline without this) ──────────────
# Only the anon key is safe in frontend with proper Row Level Security.
# See docs/SUPABASE_SCHEMA.sql for RLS setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── FIREBASE AUTHENTICATION & FIRESTORE ──────────────────────────────────────
# Add your Firebase Web App credentials from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── WHATSAPP INTEGRATION ────────────────────────────────────────────────────
# This is the ONLY frontend var needed for WhatsApp.
# Set to your Vercel deployment URL + /api/whatsapp-sos
# Example: https://life-line-subhamshaw0107s-projects.vercel.app/api/whatsapp-sos
# Leave blank if deploying on Vercel (will use relative /api/whatsapp-sos automatically)
VITE_WHATSAPP_API_URL=

# ── SERVER-SIDE ONLY (Set in Vercel Dashboard > Settings > Env Vars) ────────
# These MUST NOT be prefixed with VITE_ — they must NEVER appear in frontend code
# Go to: https://console.cloud.google.com > WhatsApp Business > Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_TEMPLATE_NAME=lifeline_sos_alert
WHATSAPP_TEMPLATE_LANG=en
ALLOWED_ORIGIN=https://subhamshaw0107.github.io